# Defaults imported from the connected iPhone Aidoku preferences
AIDOKU_TRANSLATION_BASE_URL=https://edgexpert-6027.tail39860f.ts.net
AIDOKU_TRANSLATION_MODEL=gemma-4-26b-a4b-it
AIDOKU_TRANSLATION_PROTOCOL=responses
AIDOKU_TRANSLATION_SOURCE=ja
AIDOKU_TRANSLATION_TARGET=ko
AIDOKU_TRANSLATION_INCLUDE_IMAGE=true
AIDOKU_TRANSLATION_FILTER_SFX=true
AIDOKU_TRANSLATION_FILTER_BACKGROUND=true
AIDOKU_TRANSLATION_RTL=false
AIDOKU_TRANSLATION_ALLOW_LOCAL_HTTP=false
AIDOKU_OCR_TIER=medium
AIDOKU_OCR_CONFIDENCE=0.35
AIDOKU_OCR_DETECTOR_SIDE=800
AIDOKU_OCR_RECOGNIZER_WIDTH=1184
AIDOKU_TRANSLATION_API_KEY=
AIDOKU_TRANSLATION_REASONING=none
AIDOKU_TRANSLATION_TIMEOUT=120
AIDOKU_TRANSLATION_SOURCE_LANGUAGES='["en","ja"]'
AIDOKU_OCR_DETECTOR_PIXEL_THRESHOLD=0.3
AIDOKU_OCR_DETECTOR_CONFIDENCE_THRESHOLD=0.3
AIDOKU_OCR_DETECTOR_MINIMUM_BOX_SIDE=3
AIDOKU_IPHONE_OVERLAY_JSON='{"subtitleMaxLines":2,"subtitlePosition":"bottom","visible":true,"colorMode":"white","preserveSourceBackgroundColor":true,"mode":"translateOnly","preserveSourceTextColor":true,"opacity":1,"textPlacement":"replace","inpaintingEnabled":true,"subtitleContextSentences":0}'
AIDOKU_IPHONE_SCHEDULING_JSON='{"concurrency":8,"automatic":true,"background":true,"pretranslationLimit":50,"cacheLimitBytes":1000000000}'
AIDOKU_IPHONE_BUNDLE_ID=dev.junjae.Aidoku

# Bounded page workers; imported phone concurrency is 8
AIDOKU_IMAGE_JOBS=8

# Reader container in screen points; override with the actual reader viewport.
AIDOKU_RENDER_VIEWPORT=430x932
