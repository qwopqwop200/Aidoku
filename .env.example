# Example settings for the V2 page-translation host (swift Scripts/image-translation.swift).
# Copy to .env (ignored by Git). Precedence: CLI arguments > shell environment > .env > defaults.
AIDOKU_TRANSLATION_BASE_URL=https://your-provider.example/v1
AIDOKU_TRANSLATION_MODEL=gemma-4-26b-a4b-it
AIDOKU_TRANSLATION_PROTOCOL=responses
AIDOKU_TRANSLATION_REASONING=none
AIDOKU_TRANSLATION_TIMEOUT=120
AIDOKU_TRANSLATION_SOURCE=ja
AIDOKU_TRANSLATION_TARGET=ko
AIDOKU_TRANSLATION_ALLOW_LOCAL_HTTP=false
AIDOKU_TRANSLATION_API_KEY=
# Optional nonsecret rotation counter; increment after changing credentials/account/tenant.
# Never put a secret or hash here.
# AIDOKU_TRANSLATION_CREDENTIAL_GENERATION=1
# Concurrent page requests to the provider (capped at 3, like the app).
AIDOKU_TRANSLATION_CONCURRENCY=3
# AIDOKU_IPHONE_BUNDLE_ID=com.example.Aidoku

# Pages in flight (models stay resident).
AIDOKU_IMAGE_JOBS=3
# rightToLeft (manga), leftToRight or topToBottom (webtoon).
AIDOKU_READING_DIRECTION=rightToLeft
