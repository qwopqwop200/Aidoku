// base identifiers
APP_ID_PREFIX               = app.aidoku
APP_ID_SUFFIX               = Aidoku

PRODUCT_BUNDLE_IDENTIFIER   = $(APP_ID_PREFIX).$(APP_ID_SUFFIX)

// ----- iCloud / CloudKit -----
ICLOUD_CONTAINER_ID         = iCloud.$(PRODUCT_BUNDLE_IDENTIFIER)
UBIQUITY_KVSTORE_ID         = $(TeamIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)

// Store build
// Dev / sideload build (leave flag 'CANONICAL_BUILD' undefined)
OTHER_SWIFT_FLAGS = $(inherited) -DCANONICAL_BUILD

// Shared image inbox used by the app and its Share extension.
SHARED_IMAGE_APP_GROUP = group.$(APP_ID_PREFIX).$(APP_ID_SUFFIX)

// Route extension handoff to the matching installation when multiple builds coexist.
SHARED_IMAGE_URL_SCHEME = $(APP_ID_PREFIX).$(APP_ID_SUFFIX).shared

SHARE_EXTENSION_DISPLAY_NAME = Aidoku

// Optional access group for installations explicitly sharing translation credentials.
TRANSLATION_KEYCHAIN_ACCESS_GROUP =
