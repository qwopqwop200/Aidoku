"TRANSLATION_HELP" = "மொழிபெயர்ப்பு சின்னம் மொழிபெயர்ப்பை இயக்கும் அல்லது முடக்கும். முதலில் திரையில் தெரியும் பக்கங்களும் பின்னர் அருகிலுள்ள பக்கங்களும் தயாராகும். நீங்கள் படிக்கும் இடத்திற்கு ஏற்ப தயாரிப்பு நடைபெறும். சேமித்த OCR, மொழிபெயர்ப்புகள் மற்றும் உரை அமைப்பை வாசிப்பானை மீண்டும் திறந்த பிறகும் செயலியை மறுதொடக்கம் செய்த பிறகும் பயன்படுத்தலாம். தற்காலிகமாகப் பகிரப்பட்ட படங்களுக்கு இந்தத் தற்காலிகச் சேமிப்பு சேமிக்கப்படாது. வாசிப்பானிலிருந்து வெளியேறும்போது முடிவடையாத வேலை ரத்து செய்யப்படும்.";

"TRANSLATION_PRIVACY" = "OCR உங்கள் சாதனத்தில் இயங்கும். மொழிபெயர்ப்புக்காக அடையாளம் காணப்பட்ட உரையும் உங்கள் வழிமுறைகளும் தேர்ந்தெடுக்கப்பட்ட வழங்குநருக்கு அனுப்பப்படும். மொழிபெயர்ப்பில் பக்கப் படத்தைச் சேர்க்கும் விருப்பம் இயக்கப்பட்டிருந்தால், செயலாக்கப்பட்ட பக்கப் படமும் பதிவேற்றப்படலாம். பட உள்ளீடு ஆதரிக்கப்படாவிட்டால், உரையை மட்டும் கொண்டு மொழிபெயர்ப்பு தொடரும். API கட்டணங்கள் உங்கள் வழங்குநரைப் பொறுத்தவை. API விசைகள் Keychain-இல் சேமிக்கப்படும். OCR, மொழிபெயர்ப்புகள் மற்றும் உரைத் தளவமைப்பு ஆகியவை காப்புப் பிரதிகளில் சேர்க்கப்படாத பாதுகாக்கப்பட்ட பயன்பாட்டு சேமிப்பகத்தில் சேமிக்கப்படும்.";

